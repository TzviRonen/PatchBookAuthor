# Knobs for cron/run-slot.sh. Sourced as bash; keep it to plain assignments.
# Every value can also be overridden from the environment (cron line, or a
# manual invocation), because run-slot.sh only defaults what is still unset.

# Gate 1: run only while five_hour.utilization <= (100 - MIN_REMAINING_PCT).
: "${MIN_REMAINING_PCT:=20}"

# Gate 2: run only when five_hour.resets_at is this many minutes away or less.
: "${RESET_WITHIN_MIN:=60}"

# Backend passed to run_cve.py. IDA is the pipeline default but needs the IDA
# VM (pipeline/config.py) reachable; ghidra runs self-contained.
: "${BACKEND:=ida}"

# 1 = push the published report to the live site; 0 = commit locally only.
: "${PUSH:=1}"

# Give up on a CVE after this many failed attempts, so one poison entry cannot
# consume every future slot.
: "${MAX_ATTEMPTS:=2}"

# cron's PATH is minimal (/usr/bin:/bin). The job needs claude, java, python3,
# git, jq and curl.
export PATH=${PATCHBOOK_CRON_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$HOME/.local/bin}
