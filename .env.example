# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# How often to poll MSRC for new CVEs (default: 24 hours)
POLL_INTERVAL_HOURS=24

# Windows version to target for binary downloads (default: 10)
TARGET_WINDOWS_VERSION=10

# Output verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── IDA Pro backend (run_cve.py --backend ida) ────────────────────────────
# IDA runs on a Windows VM; the pipeline reaches it over an SSH tunnel.
IDA_VM_HOST=192.168.10.128
IDA_VM_USER=auto
IDA_VM_KEY=./auto_vm_key.pub
IDA_WORK_DIR=C:\ida_work
IDA_INSTALL_DIR=C:\Program Files\IDA Professional 9.3
IDA_MCP_STARTUP_TIMEOUT=900
